rules_version = '2';

// ===============================================================
// Assumed Data Model & Security Schema
// Sayuni Jerusalem Church (Hekalu la Sayuni - Mbagala)
//
// 1. announcements:
//    - id: string
//    - title: string (1-300 chars)
//    - body / content / summary: string (1-10000 chars)
//    - type: optional or string in ['normal', 'urgent', 'bereavement', 'high']
//    - category, branch, targetAudience, authorRole, authorEmail, author, priority: optional strings
//    - createdAt: timestamp / string
//
// 2. sermons:
//    - title: string (1-300 chars)
//    - preacher: optional string (<= 200 chars)
//    - mediaUrl / media_url: string
//    - scripture, duration, type, category, description, createdAt
//
// 3. choir_songs:
//    - title: string (1-300 chars)
//    - audioUrl / audio_url: string
//    - choirName, lyrics, keySignature, tempo, createdAt
//
// 4. visitors_registry:
//    - fullName / full_name: string (<= 200 chars)
//    - phone / phoneNumber: string (>= 7 chars)
//    - consent / consentGiven: boolean == true
//    - residence, assignedJumuiya, prayerRequest, followUpStatus, createdAt
//    - STRICT CONFIDENTIALITY: Accessible only by church deacons & administration.
//
// 5. sunday_school_content:
//    - title, lessonNotes, memoryVerse, targetAge, teacherNotes, createdAt
//
// 6. prayer_requests:
//    - title, senderName, requestText / content / message (<= 5000 chars), urgency, userId, isAnswered, createdAt
//    - STRICT CONFIDENTIALITY: Pastoral desk & author only.
//
// 7. jumuiya_reports:
//    - jumuiyaName / jumuiya: string
//    - leaderName, leaderPhone, attendanceCount, offeringAmount, topicTaught, prayerNeeds, submittedAt
//    - STRICT CONFIDENTIALITY: Internal leadership (Secretary, Jumuiya Leaders, Pastors, Admin).
//
// 8. church_settings:
//    - System-level church settings (Public Read, Admin Write).
//
// 9. profiles:
//    - fullName, phone, email, jumuiya, role, memberId, isVerifiedMember
//    - Protected: Users can manage their own profile, Secretary can manage all.
//
// 10. consent_records:
//    - uid, version, purposes, acceptedAt (PDPA 2022 audit compliance).
//
// 11. role_grants & audit_logs & members:
//    - Read restricted to Admin / Secretary; write restricted to Cloud Functions Admin SDK.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    //
    // ROLE SOURCE OF TRUTH
    // Authentication authority comes ONLY from verified Firebase Auth
    // custom claims (set by functions/setUserRole via Admin SDK).
    // No email allowlist — anyone can register any email address, so an
    // email check without email_verified would be a privilege escalation.
    // Client-supplied profile fields are never trusted.

    function isSignedIn() {
      return request.auth != null;
    }

    /// Privileged access requires a verified email address.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    /// True when the account has actually been assigned a church role or admin claim.
    function hasRoleClaim() {
      return isSignedIn() && (request.auth.token.role != null || request.auth.token.admin == true);
    }

    /// Resolves the user's effective role.
    /// Returns 'guest' if not signed in, the token role if present, 'admin' if admin claim is set, or 'member'.
    function getUserRole() {
      return !isSignedIn() ? 'guest' :
        (hasRoleClaim() && request.auth.token.role != null ? request.auth.token.role :
        (hasRoleClaim() && request.auth.token.admin == true ? 'admin' : 'member'));
    }

    /// Administrator verification: custom claim role or legacy admin flag only.
    /// Requires verified email — unverified accounts get no privilege.
    function isAdmin() {
      return isVerified() && (
        request.auth.token.role in ['admin', 'super_admin'] ||
        request.auth.token.admin == true
      );
    }

    /// Pastoral verification: administrator or pastor claim only.
    function isPastor() {
      return isAdmin() || (isVerified() && getUserRole() == 'pastor');
    }

    /// Secretary (Katibu) verification: administrator, pastor, or secretary claim only.
    function isSecretary() {
      return isAdmin() ||
        isPastor() ||
        (isVerified() && getUserRole() == 'secretary');
    }

    /// Deacon verification: secretary, pastor, admin, or deacon role.
    function isDeacon() {
      return isSecretary() || (isVerified() && getUserRole() == 'deacon');
    }

    /// Ushers (wakaribishaji) handle visitor reception and may log events.
    function isUsher() {
      return isVerified() && getUserRole() == 'usher';
    }

    /// Any recognised church worker (portal-eligible role) may log an event.
    function isChurchWorker() {
      return isSecretary() || isDeacon() || isUsher() ||
        (isVerified() && getUserRole() in ['treasurer', 'jumuiya_leader',
          'choir_leader', 'children_teacher']);
    }

    function isValidEvent(data) {
      return data.keys().hasAny(['title']) && data.title is string &&
             data.title.size() >= 1 && data.title.size() <= 300 &&
             data.keys().hasAny(['description']) && data.description is string &&
             data.description.size() >= 1 && data.description.size() <= 10000 &&
             (!data.keys().hasAny(['posterStatus']) ||
               data.posterStatus in ['none', 'requested', 'ready']);
    }

    // --- Data Validation Functions ---

    function isValidAnnouncement(data) {
      return (data.keys().hasAny(['title']) && data.title is string && data.title.size() >= 1 && data.title.size() <= 300) &&
             (
               (data.keys().hasAny(['body']) && data.body is string && data.body.size() >= 1 && data.body.size() <= 10000) ||
               (data.keys().hasAny(['content']) && data.content is string && data.content.size() >= 1 && data.content.size() <= 10000) ||
               (data.keys().hasAny(['summary']) && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 10000)
             ) &&
             (
               !data.keys().hasAny(['type']) ||
               data.type in ['normal', 'urgent', 'bereavement', 'high']
             );
    }

    function isValidSermon(data) {
      return (data.keys().hasAny(['title']) && data.title is string && data.title.size() >= 1 && data.title.size() <= 300) &&
             (!data.keys().hasAny(['preacher']) || (data.preacher is string && data.preacher.size() <= 200)) &&
             ((data.keys().hasAny(['mediaUrl']) && data.mediaUrl is string && data.mediaUrl.size() <= 1000) ||
              (data.keys().hasAny(['media_url']) && data.media_url is string && data.media_url.size() <= 1000));
    }

    function isValidChoirSong(data) {
      return (data.keys().hasAny(['title']) && data.title is string && data.title.size() >= 1 && data.title.size() <= 300) &&
             ((data.keys().hasAny(['audioUrl']) && data.audioUrl is string && data.audioUrl.size() <= 1000) ||
              (data.keys().hasAny(['audio_url']) && data.audio_url is string && data.audio_url.size() <= 1000));
    }

    function isValidVisitor(data) {
      // PDPA 2022: Visitor contact data is only accepted when consent is affirmed.
      return ((data.keys().hasAny(['fullName']) && data.fullName is string && data.fullName.size() <= 200) ||
              (data.keys().hasAny(['full_name']) && data.full_name is string && data.full_name.size() <= 200)) &&
             ((data.keys().hasAny(['phone']) && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30) ||
              (data.keys().hasAny(['phoneNumber']) && data.phoneNumber is string && data.phoneNumber.size() >= 7 && data.phoneNumber.size() <= 30)) &&
             ((data.keys().hasAny(['consent']) && data.consent == true) ||
              (data.keys().hasAny(['consentGiven']) && data.consentGiven == true));
    }

    function isValidConsent(data) {
      return (data.keys().hasAny(['uid']) && data.uid is string && data.uid.size() <= 128) &&
             (data.keys().hasAny(['version']) && data.version is string && data.version.size() <= 50) &&
             (data.keys().hasAny(['purposes']) && data.purposes is list && data.purposes.size() <= 20) &&
             (data.keys().hasAny(['acceptedAt']) && data.acceptedAt != null);
    }

    function isValidPrayerRequest(data) {
      return (
        (data.keys().hasAny(['requestText']) && data.requestText is string && data.requestText.size() <= 5000) ||
        (data.keys().hasAny(['content']) && data.content is string && data.content.size() <= 5000) ||
        (data.keys().hasAny(['message']) && data.message is string && data.message.size() <= 5000)
      ) &&
      (request.auth == null || !data.keys().hasAny(['userId']) || data.userId == null || data.userId == request.auth.uid);
    }

    function isValidJumuiyaReport(data) {
      return ((data.keys().hasAny(['jumuiyaName']) && data.jumuiyaName is string && data.jumuiyaName.size() <= 200) ||
              (data.keys().hasAny(['jumuiya']) && data.jumuiya is string && data.jumuiya.size() <= 200));
    }

    // --- Collection Security Rules ---

    // 1. Announcements (Public Read, Secretary/Admin Write only)
    // Previously ANY signed-in user could create — that let every member
    // publish church-wide notices. Now leaders only.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if (isSecretary() && isValidAnnouncement(request.resource.data));
      allow update, delete: if isSecretary() || isAdmin();
    }

    // 2. Sermons & Pastoral Media (Public Read, Pastor/Admin Write only)
    match /sermons/{sermonId} {
      allow read: if true;
      allow create, update: if (isPastor() && isValidSermon(request.resource.data));
      allow delete: if isAdmin() || isPastor();
    }

    // 3. Church Choir Songs & Audio (Public Read, Choir Leader/Admin Write only)
    match /choir_songs/{songId} {
      allow read: if true;
      allow create, update: if ((isAdmin() || (isVerified() && getUserRole() == 'choir_leader')) && isValidChoirSong(request.resource.data));
      allow delete: if isAdmin();
    }

    // 4. Visitors & Guest Reception (CONFIDENTIAL: Deacons, Secretary, Pastors, Admin Only)
    match /visitors_registry/{visitorId} {
      // Ushers receive visitors at the door, so they may read the registry.
      allow read: if isDeacon() || isUsher();
      allow create: if isValidVisitor(request.resource.data);
      allow update, delete: if isDeacon();
    }

    // 5. Sunday School / Watoto Content (Public Read, Teachers/Admin Write)
    match /sunday_school_content/{contentId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isVerified() && getUserRole() == 'children_teacher');
      allow delete: if isAdmin();
    }

    // 6. Prayer Requests (CONFIDENTIAL: Pastoral Desk & Author Only)
    match /prayer_requests/{requestId} {
      allow create: if isValidPrayerRequest(request.resource.data);
      allow read, update: if (isSignedIn() && isPastor()) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || isPastor();
    }

    // 7. Jumuiya Reports (CONFIDENTIAL: Jumuiya Leaders, Pastors, Secretary, Admin Only)
    match /jumuiya_reports/{reportId} {
      allow read: if isSecretary() || (isVerified() && getUserRole() == 'jumuiya_leader') || isAdmin();
      allow create, update: if (isSecretary() || (isVerified() && getUserRole() == 'jumuiya_leader') || isAdmin()) && isValidJumuiyaReport(request.resource.data);
      allow delete: if isAdmin() || isPastor();
    }

    // 8. Church Leadership & System Settings (Public Read, Admin Write)
    match /church_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Member & Staff Profiles (Self-access or Secretariat)
    match /profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSecretary());
      allow create: if ((isSignedIn() && request.auth.uid == userId) || isSecretary()) &&
        !request.resource.data.keys().hasAny(['role', 'isVerifiedMember']);
      allow update: if ((isSignedIn() && request.auth.uid == userId) || isSecretary()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerifiedMember']);
      allow delete: if isSecretary();
    }

    // 10. Consent Register (PDPA 2022 — proof of lawful basis)
    match /consent_records/{consentId} {
      allow get: if (isSignedIn() && request.auth.uid == resource.data.uid) ||
                    isAdmin() || isSecretary();
      allow list: if isAdmin() || isSecretary();
      allow create: if isSignedIn() &&
                      request.auth.uid == request.resource.data.uid &&
                      isValidConsent(request.resource.data);
      allow update, delete: if false;
    }

    // 11. Role grants — audit trail of who assigned which role to whom (Functions / Admin SDK only)
    match /role_grants/{grantId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 12. Append-only audit log of privileged actions (Functions / Admin SDK only)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isSecretary();
      allow write: if false;
    }

    // 13. Events / poster requests: written by church workers on any device,
    //     read by the whole portal, signed off by secretariat/root only.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isChurchWorker() && isValidEvent(request.resource.data);
      allow update: if (isSecretary() || isAdmin()) && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    // 14. Mirror of the auth claims, written by setUserRole / onMemberCreate
    match /members/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSecretary());
      allow list: if isSecretary();
      allow write: if false;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
