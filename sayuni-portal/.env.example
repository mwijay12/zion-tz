# Copy to .env.local. Never commit real keys.
# WARNING: every VITE_* value is shipped in the browser bundle and is
# visible to anyone who opens the site. Never put a secret here.
VITE_CLOUDINARY_CLOUD_NAME=zion-fellowship
VITE_CLOUDINARY_UPLOAD_PRESET=zion_unsigned

# Comma-separated Google AI Studio keys used by the browser TTS demo.
# These are visible in the bundle — use a throwaway key with a quota cap,
# or route TTS through a server-side proxy in production.
VITE_GEMINI_TTS_KEYS=

# Local demo login (fake leader sessions, no Firebase, no cloud writes).
# Demo credentials shown on the sign-in screen:
#   email:    demo@sayuni.local
#   password: SayuniDemo2026
# Enabled automatically in `vite dev`. Set VITE_DEMO_MODE=true to also show
# them in deployed builds (Vercel production/preview showcase). This is NOT a
# secret — the demo session cannot write to Firestore and carries an isDemo
# banner. Never enable alongside real member data; see docs/DEMO_CREDENTIALS.md.
VITE_DEMO_MODE=false
