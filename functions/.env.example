# Copia hii kama `functions/.env` kabla ya `firebase deploy --only functions`.
# `process.env.ZION_REGION` inasomwa na functions/index.js.
#
# Region ya callable functions. africa-south1 (Johannesburg) ndiyo karibu zaidi
# na Dar es Salaam. Deploy ikikataa region hiyo (project mpya/plan ndogo),
# badilisha kuwa us-central1 — KISHA ubadilishe `ChurchRoleGrantService.region`
# sayuni/lib/core/services/church_role_grant_service.dart iwe sawa, build tena.
ZION_REGION=africa-south1
